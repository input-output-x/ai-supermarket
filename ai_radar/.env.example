# ===== AI雷达 配置 =====
# 复制为 .env 后填入；.env 绝不入库（已加入 .gitignore）

# 可选：DeepSeek key，用于把速报润色成中文摘要
# 不填则使用纯列表兜底（仍可用，只是没有 AI 总结）
DEEPSEEK_API_KEY=

# 飞书群机器人 webhook（在飞书群「设置-群机器人-添加机器人」拿到）
# 形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
FEISHU_WEBHOOK=

# 微信个人推送（PushPlus，https://www.pushplus.plus 注册拿到 token）
PUSHPLUS_TOKEN=

# 数据库：本地测试可用 SQLite，生产改成 MySQL
DATABASE_URL=sqlite:////Users/master/WorkBuddy/2026-08-22-17-01-26/ai_supermarket/web/backend/web_backend.db

# 唇形同步 Provider：local / bailian / heygen
#   local   —— 本地 TTS+字幕+嘴部动画（无需 key，默认）
#   bailian —— 阿里云百炼 wan2.2-s2v 万相数字人（真实对口型，需 DASHSCOPE_API_KEY）
#   heygen  —— HeyGen 真实数字人（需 HEYGEN_API_KEY）
LIPSYNC_PROVIDER=local

# 阿里云百炼 / DashScope API Key（sk- 开头），用于 wan2.2-s2v 逼真数字人
DASHSCOPE_API_KEY=

# 百炼数字人分辨率：480P（0.5元/秒，默认，抖音竖屏够用）/ 720P（0.9元/秒，更清晰）
BAILIAN_RESOLUTION=480P

# 如需 HeyGen 真实数字人，取消注释并填写 key
# HEYGEN_API_KEY=sk-xxx

# 抖音开放平台（publish Agent 真实发布需要）
# 1) 去 https://open.douyin.com 创建应用，拿到 client_key / client_secret，并配置回调地址
# 2) 设置下面两项，启动后在 货架→抖音发布 点「授权链接」完成 OAuth，拿到 code
# 3) 调 POST /api/agents/publish/exchange {code} 换得 access_token / open_id，填入下面两项重启
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
# DOUYIN_ACCESS_TOKEN=
# DOUYIN_OPEN_ID=

# 支付 / 计费（让套餐额度真正可收费）
# Stripe（真实 Checkout 托管页，免前端 PCI）：https://dashboard.stripe.com/apikeys 取 secret key
STRIPE_SECRET_KEY=
# Stripe Webhook Signing Secret（whsec_...）：后台配置 webhook 指向 /api/billing/webhook/stripe 时获得
STRIPE_WEBHOOK_SECRET=
# 站点公网地址（用于拼接支付成功/取消回跳；如 https://your-domain.com）
PUBLIC_BASE_URL=

# 微信支付（占位，待接 Native/JSAPI）：需商户号 + APIv3 密钥 + 证书
# WECHAT_MCH_ID=
# WECHAT_APIV3_KEY=
# WECHAT_APP_ID=
# WECHAT_SERIAL=
# WECHAT_PRIVATE_KEY=

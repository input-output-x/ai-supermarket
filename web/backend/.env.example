# 数据库：本地测试可用 SQLite，生产改成 MySQL
DATABASE_URL=sqlite:////Users/master/WorkBuddy/2026-08-22-17-01-26/ai_supermarket/web/backend/web_backend.db

# 唇形同步 Provider：local / bailian / heygen
#   local   —— 本地 TTS+字幕+嘴部动画（无需 key，默认）
#   bailian —— 阿里云百炼 wan2.2-s2v 万相数字人（真实对口型，需 DASHSCOPE_API_KEY）
#   heygen  —— HeyGen 真实数字人（需 HEYGEN_API_KEY）
LIPSYNC_PROVIDER=local

# 阿里云百炼 / DashScope API Key（sk- 开头），用于 wan2.2-s2v 逼真数字人
DASHSCOPE_API_KEY=

# 百炼数字人分辨率：480P（0.5元/秒，默认，抖音竖屏够用）/ 720P（0.9元/秒，更清晰）
BAILIAN_RESOLUTION=480P

# 如需 HeyGen 真实数字人，取消注释并填写 key
# HEYGEN_API_KEY=sk-xxx

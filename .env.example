# ===== AI超市 环境变量示例 =====
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会进入仓库。

# 【必填】Deepseek 大模型 Key（chat 用）。也可兼容任意 OpenAI 兼容端点（填下面 AI_SUPERMARKET_API_KEY）。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：指定模型（默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat
# 可选：自定义端点（默认 https://api.deepseek.com/v1）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 【可选】若想用真实语义向量做选题去重（Deepseek 无 embedding 接口），可接 OpenAI 兼容 embedding：
# AI_SUPERMARKET_EMBED_BASE_URL=https://api.openai.com/v1
# AI_SUPERMARKET_EMBED_KEY=sk-xxx
# AI_SUPERMARKET_EMBED_MODEL=text-embedding-3-small

# 【可选】兼容：直接用 OpenAI 兼容 chat（与 DEEPSEEK_API_KEY 二选一）
# AI_SUPERMARKET_API_KEY=sk-xxx
# AI_SUPERMARKET_BASE_URL=https://api.openai.com/v1
# AI_SUPERMARKET_MODEL=gpt-4o-mini
